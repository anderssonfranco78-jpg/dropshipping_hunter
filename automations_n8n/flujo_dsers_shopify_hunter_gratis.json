{
  "name": "Ralf & Co — DSers + Shopify -> Dropshipping Hunter (Sincronizador Gratuito de Stock)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "shopify-dsers-inventory",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "node-shopify-webhook",
      "name": "1. Webhook Shopify (DSers Stock Update)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        220
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "node-schedule-6h",
      "name": "1b. Consulta Espaciada (Cada 6h - Ahorro Cuota Gratis)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        420
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://ralfandco.myshopify.com/products.json?limit=50",
        "options": {}
      },
      "id": "node-shopify-poll",
      "name": "2a. Leer Catálogo Shopify (Sincronizado por DSers)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nif (Array.isArray(raw.products)) {\n  return [{ json: { updates: raw.products.map(p => ({ handle: p.handle, variants: p.variants })) } }];\n}\nreturn [{ json: raw }];"
      },
      "id": "node-normalize-payload",
      "name": "2b. Normalizar SKU / Stock / Costo DSers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8765/api/n8n/sync-stock",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Hunter",
              "value": "1"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "node-hunter-sync",
      "name": "3. Actualizar Dropshipping Hunter Local",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ Boolean($json.has_alerts) }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-ko-router",
      "name": "4. Detector de Alerta KO-STOCK (< 100 uds)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1260,
        320
      ]
    }
  ],
  "connections": {
    "1. Webhook Shopify (DSers Stock Update)": {
      "main": [
        [
          {
            "node": "2b. Normalizar SKU / Stock / Costo DSers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "1b. Consulta Espaciada (Cada 6h - Ahorro Cuota Gratis)": {
      "main": [
        [
          {
            "node": "2a. Leer Catálogo Shopify (Sincronizado por DSers)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2a. Leer Catálogo Shopify (Sincronizado por DSers)": {
      "main": [
        [
          {
            "node": "2b. Normalizar SKU / Stock / Costo DSers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2b. Normalizar SKU / Stock / Costo DSers": {
      "main": [
        [
          {
            "node": "3. Actualizar Dropshipping Hunter Local",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "3. Actualizar Dropshipping Hunter Local": {
      "main": [
        [
          {
            "node": "4. Detector de Alerta KO-STOCK (< 100 uds)",
            "type": "main",
            "index": 0
          }
        ]
